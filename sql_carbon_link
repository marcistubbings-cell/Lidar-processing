-- This is how carbon results (CARBON_STOCK_KG_CARBON) can be shown for greenspaces (GRENSPACE_ID, SITE_NAME, SITE_TYPE)

SELECT table_name FROM user_tables
WHERE table_name IN ('GREENSPACE_ID_NAME', 'GREENSPACE_ID_NAME_CARBON_RESULT')
ORDER BY table_name;

CREATE TABLE greenspace_id_name (
    greenspace_id VARCHAR2(100) PRIMARY KEY,
    site_name     VARCHAR2(150),
    site_type     VARCHAR2(100)
);

CREATE TABLE greenspace_id_name_carbon_result (
    greenspace_id VARCHAR2(100) PRIMARY KEY,
    carbon_stock_kg_carbon   NUMBER CHECK (carbon_stock_kg_carbon >= 0),
    CONSTRAINT cgs_demo_carbon_site_fk
        FOREIGN KEY (greenspace_id)
        REFERENCES greenspace_id_name (greenspace_id)
);

