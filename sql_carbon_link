SELECT gs.greenspace_id, gs.site_name, gs.site_type,
       carbon.carbon_stock_kg_carbon
FROM greenspace_id_name gs
LEFT JOIN greenspace_id_name_carbon_result carbon
    ON gs.greenspace_id = carbon.greenspace_id
ORDER BY gs.greenspace_id;
